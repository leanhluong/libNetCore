<Project>

  <!--
    ============================================================
    MỘT NGUỒN SỰ THẬT cho version + metadata của mọi package.

    LOCKSTEP VERSIONING: cả 3 package cùng chung MỘT số version.
    Phát hành = sửa <Version> ở đây MỘT lần, rồi tag repo v$(Version).

    KHÔNG thêm <Version> vào từng .csproj — nó sẽ ghi đè chỗ này
    một cách âm thầm và làm version lệch nhau.
    ============================================================
  -->

  <PropertyGroup>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>

    <!-- Bắt null lúc biên dịch, không đợi tới lúc chạy mới nổ NullReferenceException -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Thư viện dùng chung thì không được có warning. Warning hôm nay = bug của người dùng ngày mai -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Metadata NuGet — chỉ áp cho project trong src/, không áp cho test -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false' AND $(MSBuildProjectDirectory.Contains('src'))">
    <Authors>Le Anh Luong</Authors>
    <Company>Le Anh Luong</Company>
    <Description>Bộ mảnh dùng chung không dính nghiệp vụ cho dịch vụ .NET: Result/Error, Entity/AggregateRoot, Outbox/Inbox, cache, khoá phân tán, CQRS.</Description>
    <PackageTags>clean-architecture;ddd;cqrs;result;outbox;inbox;shared-kernel</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/leanhluong/libNetCore</PackageProjectUrl>
    <RepositoryUrl>https://github.com/leanhluong/libNetCore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!--
      Gói ký hiệu (.snupkg) để người dùng gỡ lỗi bước thẳng vào code của lib.
      EmbedUntrackedSources + ContinuousIntegrationBuild làm cho đường dẫn file trong
      gói ký hiệu là đường dẫn TƯƠNG ĐỐI, không phải "D:\Nextx\..." trên máy tôi —
      thiếu nó thì người khác tải symbol về cũng không mở được file.
    -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup Condition="'$(PackageReadmeFile)' != ''">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
